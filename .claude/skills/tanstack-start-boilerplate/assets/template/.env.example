# Copy this file to .env.local and fill in the values.
# The dev script loads .env.local via dotenv-cli (see package.json "dev").

# Your Sentry DSN (from your Sentry account) — leave empty to disable Sentry
VITE_SENTRY_DSN=

# Your Sentry organization (from your Sentry account)
VITE_SENTRY_ORG=

# Your Sentry project (from your Sentry account)
VITE_SENTRY_PROJECT=

# Your Sentry authentication token (from your Sentry account)
SENTRY_AUTH_TOKEN=
